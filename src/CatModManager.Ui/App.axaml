<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CatModManager.Ui.App"
             xmlns:local="using:CatModManager.Ui"
             xmlns:theme="using:CatModManager.Theme"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Every brush resolves from CatModManager.Theme.CmmPalette, so the XAML styles and the
             controls built in code-behind cannot drift apart. Add new colours there, not here. -->
        <SolidColorBrush x:Key="AppBackground"    Color="{x:Static theme:CmmPalette.AppBackground}"/>
        <SolidColorBrush x:Key="SidebarBg"        Color="{x:Static theme:CmmPalette.SidebarBg}"/>
        <SolidColorBrush x:Key="SidebarHeaderBg"  Color="{x:Static theme:CmmPalette.SidebarHeaderBg}"/>
        <SolidColorBrush x:Key="ContentBg"        Color="{x:Static theme:CmmPalette.ContentBg}"/>
        <SolidColorBrush x:Key="SurfaceBg"        Color="{x:Static theme:CmmPalette.SurfaceBg}"/>
        <SolidColorBrush x:Key="SurfaceSelected"  Color="{x:Static theme:CmmPalette.SurfaceSelected}"/>
        <SolidColorBrush x:Key="SurfaceHover"     Color="{x:Static theme:CmmPalette.SurfaceHover}"/>
        <SolidColorBrush x:Key="SurfaceSelectedHover" Color="{x:Static theme:CmmPalette.SurfaceSelectedHover}"/>

        <SolidColorBrush x:Key="BorderColor"      Color="{x:Static theme:CmmPalette.Border}"/>
        <SolidColorBrush x:Key="BorderSubtle"     Color="{x:Static theme:CmmPalette.BorderSubtle}"/>

        <SolidColorBrush x:Key="TextPrimary"      Color="{x:Static theme:CmmPalette.TextPrimary}"/>
        <SolidColorBrush x:Key="TextMuted"        Color="{x:Static theme:CmmPalette.TextMuted}"/>
        <SolidColorBrush x:Key="TextSubtle"       Color="{x:Static theme:CmmPalette.TextSubtle}"/>
        <SolidColorBrush x:Key="TextInactive"     Color="{x:Static theme:CmmPalette.TextInactive}"/>

        <SolidColorBrush x:Key="AccentColor"      Color="{x:Static theme:CmmPalette.Accent}"/>
        <SolidColorBrush x:Key="AccentHover"      Color="{x:Static theme:CmmPalette.AccentHover}"/>
        <SolidColorBrush x:Key="AccentTint"       Color="{x:Static theme:CmmPalette.AccentTint}"/>

        <SolidColorBrush x:Key="StatusActive"     Color="{x:Static theme:CmmPalette.StatusActive}"/>
        <SolidColorBrush x:Key="StatusDanger"     Color="{x:Static theme:CmmPalette.StatusDanger}"/>
        <SolidColorBrush x:Key="StatusWarning"    Color="{x:Static theme:CmmPalette.StatusWarning}"/>
        <SolidColorBrush x:Key="StatusDangerStrong" Color="{x:Static theme:CmmPalette.StatusDangerStrong}"/>
        <SolidColorBrush x:Key="StatusDangerBorder" Color="{x:Static theme:CmmPalette.StatusDangerBorder}"/>
        <SolidColorBrush x:Key="StatusDangerTint"   Color="{x:Static theme:CmmPalette.StatusDangerTint}"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <Style Selector="Button, ComboBox, TextBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.sidebar-section-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,16,12,4"/>
        </Style>

        <Style Selector="Button.sidebar-nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInactive}"/>
        </Style>
        <Style Selector="Button.sidebar-nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="TextBox.command-bar-input">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.launch-btn">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Button.launch-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <!-- The secondary button look: outlined, never accent. Purely visual, so anything can wear
             it. `mount-btn` stays a separate marker class carrying no style of its own — it says
             *which* button this is, which is how the mount button is found by name elsewhere. -->
        <Style Selector="Button.outline-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- A folder shortcut in the sidebar: reads as a line of text rather than a control. A
             column of five outlined buttons would shout as loudly as LAUNCH does. -->
        <Style Selector="Button.folder-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
        </Style>
        <Style Selector="Button.folder-link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>

        <!-- Every mod row eases opacity and position, so a live reorder slides instead of snapping. -->
        <Style Selector="ListBox#ModsListBox Grid">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Held state: lifted, not faded. The row now travels with the pointer and leaves its slot
             empty behind it, so it has to read as the thing being carried — dimming it would make
             the empty slot look like the real row and the moving one like a ghost. -->
        <Style Selector="ListBox#ModsListBox Grid.dragging">
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
        </Style>

        <!-- Looks like the plain header it replaces; only the cursor and hover reveal it clicks. -->
        <Style Selector="Button.sort-header">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.sort-header:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.sort-header:disabled">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="ToggleButton.reorder-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
        </Style>

        <!-- The armed state has to read at a glance: while it is on, dragging rewrites load order. -->
        <Style Selector="ToggleButton.reorder-toggle:checked">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBackground}"/>
        </Style>

        <Style Selector="Button.danger-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StatusDangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusDanger}"/>
        </Style>
        <Style Selector="Button.danger-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatusDangerTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StatusDanger}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource StatusDanger}"/>
        </Style>

        <Style Selector="TextBlock.inspector-field-label">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBox.path-field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace"/>
            <Setter Property="Padding" Value="2,4"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- An incomplete install. Paired with the INCOMPLETE badge, which carries the meaning for
             anyone who cannot rely on the colour alone. -->
        <Style Selector="TextBlock.broken">
            <Setter Property="Foreground" Value="{DynamicResource StatusDanger}"/>
        </Style>

        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.small-icon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
        </Style>
        <Style Selector="Button.small-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <!-- The title-bar menu. Sized down to sit inside 32px without making the bar taller. -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Menu > MenuItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="Menu > MenuItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

    </Application.Styles>
</Application>
