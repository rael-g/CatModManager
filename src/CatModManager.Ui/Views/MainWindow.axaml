<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CatModManager.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:CatModManager.Core.Models"
        xmlns:services="using:CatModManager.Core.Services"
        xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:pluginSdk="using:CatModManager.PluginSdk"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
        x:Class="CatModManager.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Name="RootWindow"
        Icon="/Assets/icon.ico"
        Title="The Schrödinger Cat Mod Manager"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        MinWidth="1160"
        MinHeight="580">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="32, *, 24">
        
        <!-- 1. Custom Title Bar (Drag Zone + Menu)

             The menu lives here rather than in a bar of its own: these 32px already exist and were
             doing nothing but carrying the app name. It is also the home for every command that is
             used rarely, which is what keeps the command bar below from growing until it clips. -->
        <Grid Grid.Row="0" Background="{DynamicResource AppBackground}" PointerPressed="TitleBar_PointerPressed"
              ColumnDefinitions="Auto, *">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CMM" Foreground="{DynamicResource AccentColor}" FontWeight="Black" FontSize="10"
                           Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Menu VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="Add Mod">
                            <MenuItem Header="From _Archive…" Click="AddModFromArchive_Click"/>
                            <MenuItem Header="From _Folder…"  Click="AddModFromFolder_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Rescan Mods Folder" Command="{Binding RefreshCommand}"/>
                        <Separator/>
                        <MenuItem Header="Open Folder">
                            <MenuItem Header="_Mods"      Command="{Binding OpenModsFolderCommand}"/>
                            <MenuItem Header="_Downloads" Command="{Binding OpenDownloadsFolderCommand}"/>
                            <MenuItem Header="_Game"      Command="{Binding OpenGameFolderCommand}"/>
                            <MenuItem Header="Game D_ata" Command="{Binding OpenGameDataFolderCommand}"/>
                            <MenuItem Header="App Data"   Command="{Binding OpenAppDataFolderCommand}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="Exit_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Mod">
                        <MenuItem Header="_Open Folder"        Command="{Binding OpenSelectedModFolderCommand}"/>
                        <MenuItem Header="Change _Mount Point" Click="ChangeMountPoint_Click"/>
                        <Separator/>
                        <MenuItem Header="_Remove Mod" Command="{Binding RemoveModCommand}"/>
                    </MenuItem>

                    <MenuItem Header="_Game">
                        <MenuItem Header="_Add Game…"      Command="{Binding GameManager.AddGameCommand}"/>
                        <MenuItem Header="_Edit Game…"     Click="GameSettings_Click"/>
                        <MenuItem Header="Re_move Game"    Command="{Binding GameManager.DeleteGameCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Switch To" ItemsSource="{Binding GameManager.AvailableGames}">
                            <MenuItem.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                              x:DataType="models:Game">
                                    <Setter Property="Header"           Value="{Binding DisplayName}"/>
                                    <Setter Property="Command"          Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GameManager.SelectGameCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Auto Detect Game…"      Command="{Binding GameConfig.AutoDetectGameCommand}"/>
                        <MenuItem Header="Detect Game _Mode"       Command="{Binding GameConfig.DetectGameSupportCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding Vfs.MountButtonText}" Command="{Binding Vfs.ToggleMountCommand}"/>
                        <MenuItem Header="_Launch Game"            Command="{Binding LaunchGameCommand}"/>
                    </MenuItem>

                    <MenuItem Header="_Profile">
                        <MenuItem Header="_New Profile"    Command="{Binding ProfileManager.NewProfileCommand}"/>
                        <MenuItem Header="_Rename Profile" Command="{Binding ProfileManager.RenameProfileCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Delete Profile" Command="{Binding ProfileManager.DeleteProfileCommand}"/>
                        <Separator/>
                        <!-- The profiles of the game that is open, and only those. -->
                        <MenuItem Header="_Switch To" ItemsSource="{Binding ProfileManager.AvailableProfiles}">
                            <MenuItem.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                              x:DataType="services:ProfileSummary">
                                    <Setter Property="Header"           Value="{Binding Name}"/>
                                    <Setter Property="Command"          Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ProfileManager.SelectProfileCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="_Tools">
                        <MenuItem Header="Add _Tool…"       Click="AddTool_Click"/>
                        <Separator/>
                        <MenuItem Header="_Browse Plugins…" Click="BrowsePlugins_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- No app name here on purpose. ExtendClientAreaToDecorationsHint leaves the window
                 title to the system, which draws it from Title — GNOME centres it right above this
                 row, and Windows and KDE show it too. Printing it again gave two identical strings
                 stacked on each other. The accent CMM to the left is the branding that remains. -->
            <Panel Grid.Column="1"/>
        </Grid>

        <!-- 2. Main Layout (Sidebar + Content + Inspector) -->
        <Grid Grid.Row="1" ColumnDefinitions="360, *, 380">
            
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="48, *, Auto">
                    
                    <!-- Workspace Header (Title) -->
                    <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="≡" Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="WORKSPACE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMuted}" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Content
                         Only what gets used while working: which game, which profile, and the three
                         actions. Everything that configures a game or a profile lives in the Game
                         and Profile menus now — it is filled in once and revisited rarely, and it
                         was taking up the whole panel. -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>

                            <TextBlock Text="GAME" Classes="sidebar-section-header"/>
                            <Border Padding="12,4">
                                <ComboBox Name="GameSelector"
                                          ItemsSource="{Binding GameManager.AvailableGames}"
                                          SelectedItem="{Binding GameManager.CurrentGame}"
                                          PlaceholderText="No game — add one from the Game menu"
                                          HorizontalAlignment="Stretch" Padding="6,4" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Game">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <TextBlock Text="PROFILE" Classes="sidebar-section-header"/>
                            <Border Padding="12,4">
                                <ComboBox Name="ProfileSelector"
                                          ItemsSource="{Binding ProfileManager.AvailableProfiles}"
                                          SelectedItem="{Binding ProfileManager.CurrentProfile}"
                                          PlaceholderText="No profile"
                                          HorizontalAlignment="Stretch" Padding="6,4" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:ProfileSummary">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <TextBlock Text="ACTIONS" Classes="sidebar-section-header"/>
                            <Border Padding="12,4">
                                <StackPanel Spacing="6">
                                    <Button HorizontalAlignment="Stretch" Padding="8,6"
                                            Classes="outline-btn"
                                            ToolTip.Tip="Install a mod from an archive or a folder">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="+" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="ADD MOD" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                <MenuItem Header="From Archive…" Click="AddModFromArchive_Click"/>
                                                <MenuItem Header="From Folder…"  Click="AddModFromFolder_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button Command="{Binding Vfs.ToggleMountCommand}"
                                            HorizontalAlignment="Stretch" Padding="8,6"
                                            Classes="outline-btn mount-btn">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="{Binding Vfs.MountButtonIcon}" Foreground="{Binding Vfs.MountButtonColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Vfs.MountButtonText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding LaunchGameCommand}"
                                            HorizontalAlignment="Stretch" Padding="8,6"
                                            Classes="launch-btn">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="▶"/>
                                            <TextBlock Text="LAUNCH" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Shortcuts, not settings: where the folders are is configured in the
                                 Game menu, but opening them is something done all the time. -->
                            <TextBlock Text="OPEN FOLDER" Classes="sidebar-section-header"/>
                            <Border Padding="12,4,12,10">
                                <StackPanel Spacing="4">
                                    <Button Command="{Binding OpenGameFolderCommand}" Classes="folder-link"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding GameConfig.BaseFolderPath}">
                                        <TextBlock Text="↗  Game folder" FontSize="11"/>
                                    </Button>
                                    <Button Command="{Binding OpenModsFolderCommand}" Classes="folder-link"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding GameConfig.ModsFolderPath}">
                                        <TextBlock Text="↗  Mods" FontSize="11"/>
                                    </Button>
                                    <Button Command="{Binding OpenDownloadsFolderCommand}" Classes="folder-link"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding GameConfig.DownloadsFolderPath}">
                                        <TextBlock Text="↗  Downloads" FontSize="11"/>
                                    </Button>

                                    <!-- Every mount point the game has, resolved to a real path. -->
                                    <ItemsControl ItemsSource="{Binding GameConfig.ResolvedGameDefinedMountPoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MountPointDef">
                                                <Button Tag="{Binding}" Click="OpenMountPointFolder_Click"
                                                        Classes="folder-link" HorizontalAlignment="Stretch"
                                                        Margin="0,4,0,0" ToolTip.Tip="{Binding Path}">
                                                    <TextBlock Text="{Binding Name, StringFormat='↗  {0}'}" FontSize="11"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding GameConfig.UserMountPoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MountPointDef">
                                                <Button Tag="{Binding}" Click="OpenMountPointFolder_Click"
                                                        Classes="folder-link" HorizontalAlignment="Stretch"
                                                        Margin="0,4,0,0" ToolTip.Tip="{Binding Path}">
                                                    <TextBlock Text="{Binding Name, StringFormat='↗  {0}'}" FontSize="11"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Command="{Binding OpenAppDataFolderCommand}" Classes="folder-link"
                                            HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                            ToolTip.Tip="{Binding AppDataPath}">
                                        <TextBlock Text="↗  CMM data" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="2" Background="{DynamicResource SidebarHeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,12">
                        <StackPanel Spacing="8">
                            <!-- Plugin-contributed sidebar actions (e.g. NEXUS MODS) -->
                            <ItemsControl ItemsSource="{Binding PluginSidebarActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pluginSdk:ISidebarAction">
                                        <Button Command="{Binding $parent[Window].DataContext.ExecuteSidebarActionCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch" Padding="8,4"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <TextBlock Text="{Binding Icon}" Foreground="{DynamicResource AccentColor}" FontSize="11"/>
                                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Click="BrowsePlugins_Click"
                                    HorizontalAlignment="Stretch" Padding="8,4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="⊞" Foreground="{DynamicResource AccentColor}" FontSize="11"/>
                                    <TextBlock Text="BROWSE PLUGINS" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="CMM ENGINE v0.3" FontSize="9" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="{DynamicResource ContentBg}" RowDefinitions="42, *">
                
                <!-- Command Bar
                     Only the three things that act on the list in front of it: find a row, narrow
                     the rows, rearrange the rows. What game and profile are open, and the actions
                     on them, are the sidebar's — this bar used to hold all of it at once. -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Border ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Search -->
                            <TextBlock Text="⌕" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" FontSize="16" Margin="16,0,0,0"/>
                            <TextBox Width="200" Watermark="Search mods..." Text="{Binding ModList.SearchText}" Classes="command-bar-input">
                                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ClearFocusCommand}"/></TextBox.KeyBindings>
                            </TextBox>

                            <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="8,8"/>

                            <!-- Category Filter -->
                            <ComboBox ItemsSource="{Binding ModList.Categories}" SelectedItem="{Binding ModList.SelectedCategory}"
                                      Width="120" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="11"/>

                            <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="8,8"/>

                            <!-- Arms drag-to-reorder. Dragging edits the load order, so it stays
                                 behind a deliberate toggle rather than being always live. -->
                            <ToggleButton Name="ReorderToggle" IsChecked="{Binding ModList.IsReorderEnabled}"
                                          Classes="reorder-toggle" VerticalAlignment="Center"
                                          ToolTip.Tip="Drag rows to change load order. Sorts by priority (winner last) while on.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⇅" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="REORDER" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </Border>


                <!-- Mod List Area -->
                <Grid Grid.Row="1" RowDefinitions="32, *">
                    <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="44, 32, *, 100, 70">
                            <!-- Filters to enabled mods only. Not a sort: it hides rows, so the dot
                                 indicator matters — a shorter list with no explanation reads as
                                 mods having gone missing. -->
                            <Button Grid.Column="0" Classes="sort-header" HorizontalAlignment="Center"
                                    Command="{Binding ModList.ToggleEnabledFilterCommand}"
                                    ToolTip.Tip="Show only enabled mods / show all">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="✓" Classes="col-header" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ModList.EnabledFilterIndicator}" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Sortable headers. Disabled while reordering: that mode owns the
                                 order, and letting a click re-sort mid-drag would move the rows
                                 out from under the pointer. -->
                            <Button Grid.Column="1" Classes="sort-header" HorizontalAlignment="Center"
                                    Command="{Binding ModList.SortByCommand}"
                                    CommandParameter="{x:Static vm:ModSortColumn.Priority}"
                                    IsEnabled="{Binding !ModList.IsReorderEnabled}"
                                    ToolTip.Tip="Load order. Ascending puts the mod that wins conflicts last.">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="#" Classes="col-header" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ModList.PrioritySortIndicator}" FontSize="7" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Classes="sort-header" HorizontalAlignment="Left" Margin="8,0"
                                    Command="{Binding ModList.SortByCommand}"
                                    CommandParameter="{x:Static vm:ModSortColumn.Name}"
                                    IsEnabled="{Binding !ModList.IsReorderEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="MOD NAME" Classes="col-header" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ModList.NameSortIndicator}" FontSize="7" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Classes="sort-header" HorizontalAlignment="Left"
                                    Command="{Binding ModList.SortByCommand}"
                                    CommandParameter="{x:Static vm:ModSortColumn.Category}"
                                    IsEnabled="{Binding !ModList.IsReorderEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="CATEGORY" Classes="col-header" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ModList.CategorySortIndicator}" FontSize="7" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="4" Text="VERSION" Classes="col-header" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Name="ModsListBox" ItemsSource="{Binding ModList.DisplayedMods}" SelectedItem="{Binding ModList.SelectedMod}" SelectionMode="Single" DragDrop.AllowDrop="True"
                             DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
                        <ListBox.ItemContainerTheme>
                            <!-- Full custom template — no BasedOn so FluentTheme never interferes -->
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="34"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Name="PART_Border"
                                                Background="Transparent"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter Name="PART_ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Padding="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                                <Style Selector="^:pointerover /template/ Border#PART_Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                </Style>
                                <Style Selector="^:selected /template/ Border#PART_Border">
                                    <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </Style>
                                <Style Selector="^:selected:pointerover /template/ Border#PART_Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedHover}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </Style>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rescan Mods Folder" Command="{Binding RefreshCommand}"/>
                                <MenuItem Header="Open Folder" Command="{Binding OpenSelectedModFolderCommand}"/>
                                <Separator/>
                                <MenuItem Header="Change Mount Point" Click="ChangeMountPoint_Click"/>
                                <Separator/>
                                <MenuItem Header="Remove Mod" Command="{Binding RemoveModCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Mod">
                                <!-- The row being dragged dims and shifts slightly, so there is
                                     feedback while the button is held rather than only on drop.
                                     Transitions carry it, and the rows it displaces, smoothly. -->
                                <Grid Background="Transparent" Classes.dragging="{Binding IsDragging}"
                                      RenderTransform="none">
                                    <!-- Discreet Progress Overlay (Bottom Edge) -->
                                    <ProgressBar IsVisible="{Binding IsInstalling}" 
                                                 Value="{Binding InstallProgress}" Maximum="100" 
                                                 Height="2" VerticalAlignment="Bottom" 
                                                 Background="Transparent" Foreground="{DynamicResource AccentColor}"
                                                 BorderThickness="0" ZIndex="1"/>

                                    <!-- Main Row Layout -->
                                    <Grid ColumnDefinitions="44, 32, *, 100, 70" Height="44">
                                        <!-- Column 0: Checkbox / Cancel Button -->
                                        <Panel Grid.Column="0">
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      IsVisible="{Binding !IsInstalling}"/>
                                            
                                            <Button Command="{Binding CancelInstallCommand}" 
                                                    IsVisible="{Binding IsInstalling}"
                                                    Padding="4" Background="Transparent" BorderThickness="0"
                                                    Width="32" Height="32"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ToolTip.Tip="Cancel installation">
                                                <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource StatusDanger}" FontWeight="Black"/>
                                            </Button>

                                            <TextBlock Text="⚠️" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       IsVisible="{Binding IsBroken}" 
                                                       ToolTip.Tip="Incomplete installation! Remove and try again."/>
                                        </Panel>
                                        
                                        <!-- Column 1: Priority / Progress % -->
                                        <Panel Grid.Column="1">
                                            <TextBlock Text="{Binding Priority}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                       Opacity="0.4" FontSize="11" FontFamily="Cascadia Code, Consolas" 
                                                       IsVisible="{Binding !IsInstalling}"/>
                                            
                                            <TextBlock Text="{Binding InstallProgress, StringFormat='{}{0:F0}%'}" 
                                                       IsVisible="{Binding IsInstalling}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                       FontSize="9" Foreground="{DynamicResource AccentColor}" FontWeight="Black"/>
                                        </Panel>

                                        <!-- Column 2: Name and Path/MountPoint -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- Red via a class, not a converter. This was bound through
                                                     ObjectConverters.IsNotNull, which on a non-nullable bool is always
                                                     true and ignores the parameter — so it produced `true` where a
                                                     brush was expected and no mod ever turned red. -->
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Classes.broken="{Binding IsBroken}"/>
                                                <Border Background="{DynamicResource StatusDanger}" CornerRadius="2" Padding="4,0" VerticalAlignment="Center" IsVisible="{Binding IsBroken}">
                                                    <TextBlock Text="INCOMPLETE" FontSize="8" FontWeight="Black" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <Panel>
                                                <TextBlock Text="{Binding ModRootPath}" FontSize="10" Foreground="{DynamicResource TextSubtle}" 
                                                           TextTrimming="CharacterEllipsis" FontFamily="Cascadia Code, Consolas, monospace" 
                                                           IsVisible="{Binding !IsInstalling}"/>
                                                <TextBlock Text="Installing archive..." FontSize="10" Foreground="{DynamicResource AccentColor}" 
                                                           FontStyle="Italic" IsVisible="{Binding IsInstalling}"/>
                                            </Panel>

                                            <Border IsVisible="{Binding MountPointDisplayName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                    Background="{DynamicResource SurfaceBg}" CornerRadius="2" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding MountPointDisplayName}" FontSize="9" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource AccentColor}" FontFamily="Cascadia Code, Consolas, monospace"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Column 3: Category -->
                                        <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                Background="{DynamicResource SurfaceBg}" CornerRadius="3" Padding="8,2">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        </Border>

                                        <!-- Column 4: Version -->
                                        <TextBlock Grid.Column="4" Text="{Binding Version}" FontSize="11" VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource TextSubtle}" Margin="8,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Inspector Panel -->
            <Border Grid.Column="2" Background="{DynamicResource SidebarHeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
                <TabControl Name="InspectorTabControl" TabStripPlacement="Top" Background="Transparent" Padding="0"
                            SelectedIndex="{Binding Inspector.SelectedTab}">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Padding" Value="14,0"/>
                        </Style>
                    </TabControl.Styles>

                    <!-- INFO tab (static) -->
                    <TabItem Header="INFO">
                        <Grid RowDefinitions="*, Auto">
                            <ScrollViewer Grid.Row="0" Padding="16">
                                <StackPanel Name="InspectorContent" Spacing="20" IsVisible="{Binding ModList.SelectedMod, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="DISPLAY NAME" Classes="inspector-field-label"/>
                                        <TextBox Text="{Binding ModList.SelectedMod.Name, UpdateSourceTrigger=LostFocus}" Classes="path-field">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ClearFocusCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="VERSION" Classes="inspector-field-label"/>
                                        <TextBox Text="{Binding ModList.SelectedMod.Version, UpdateSourceTrigger=LostFocus}" Classes="path-field">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ClearFocusCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="CATEGORY" Classes="inspector-field-label"/>
                                        <TextBox Text="{Binding ModList.SelectedMod.Category, UpdateSourceTrigger=LostFocus}" Classes="path-field">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ClearFocusCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="MOUNT POINT" Classes="inspector-field-label"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBg}" CornerRadius="3" Padding="8,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedModMountPointName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"/>
                                            </Border>
                                            <Button Grid.Column="1" Click="ChangeMountPoint_Click" Content="↺" Classes="small-icon" ToolTip.Tip="Change mount point" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="PHYSICAL PATH" Classes="inspector-field-label"/>
                                        <TextBlock Text="{Binding ModList.SelectedMod.ModRootPath}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" FontFamily="Consolas"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1" Padding="16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="12">
                                    <Button Command="{Binding OpenSelectedModFolderCommand}" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Stretch" Padding="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="↗" Foreground="{DynamicResource AccentColor}"/>
                                            <TextBlock Text="OPEN FOLDER" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RemoveModCommand}" Classes="danger-btn" HorizontalAlignment="Stretch" Padding="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="✕"/>
                                            <TextBlock Text="REMOVE MOD" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- FILES tab -->
                    <TabItem Header="FILES">
                        <Grid RowDefinitions="Auto, *">
                            <Border Grid.Row="0" Background="{DynamicResource ContentBg}" Padding="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Button Grid.Column="0" Command="{Binding Inspector.NavigateUpCommand}" Background="Transparent" Width="32" Height="32" Padding="0">
                                        <TextBlock Text="↑" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding Inspector.CurrentFolderPath}" VerticalAlignment="Center" Margin="8,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Inspector.Files}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModFileItem">
                                        <Button Command="{Binding $parent[Window].DataContext.Inspector.NavigateIntoCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="24, *, Auto" Height="28">
                                                <Panel Grid.Column="0">
                                                    <TextBlock IsVisible="{Binding IsDirectory}" Text="📁" VerticalAlignment="Center" Opacity="0.7"/>
                                                    <TextBlock IsVisible="{Binding !IsDirectory}" Text="📄" VerticalAlignment="Center" Opacity="0.5"/>
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSubtle}" IsVisible="{Binding !IsDirectory}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="32"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- TOOLS tab -->
                    <TabItem Header="TOOLS">
                        <Grid RowDefinitions="*, Auto">
                            <ListBox Grid.Row="0" ItemsSource="{Binding Tools.Tools}" SelectedItem="{Binding Tools.SelectedTool}" Background="Transparent">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ExternalTool">
                                        <Border Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                                            <!-- Launch only. Remove lives down in the editor panel:
                                                 sitting here it was one slip away from the button
                                                 the user actually meant to press. -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="9" Foreground="{DynamicResource TextSubtle}" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding $parent[Window].DataContext.Tools.LaunchToolCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="▶"
                                                        ToolTip.Tip="Launch"
                                                        Padding="8,4" Margin="4,0"
                                                        Background="{DynamicResource AccentColor}"
                                                        Foreground="White"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="1" Padding="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="8">

                                    <!-- Editor for the selected tool. Everything the game's own launch
                                         line has: a command, arguments, and whether to mount first.
                                         Until now a tool could only be created from a file dialog,
                                         so Arguments and MountBeforeLaunch were reachable only by
                                         hand-editing the profile TOML. -->
                                    <StackPanel Spacing="6"
                                                IsVisible="{Binding Tools.SelectedTool, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="NAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSubtle}"/>
                                        <TextBox Text="{Binding Tools.SelectedTool.Name, Mode=TwoWay}"
                                                 LostFocus="ToolField_Changed" FontSize="11"/>

                                        <TextBlock Text="COMMAND OR EXECUTABLE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSubtle}"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Tools.SelectedTool.ExecutablePath, Mode=TwoWay}"
                                                     LostFocus="ToolField_Changed"
                                                     FontFamily="Consolas" FontSize="11"
                                                     Watermark="/path/to/tool.exe   —   or a bare command, e.g.  steam"/>
                                            <Button Grid.Column="1" Click="BrowseTool_Click" Content="…"
                                                    Padding="8,4" Margin="4,0,0,0"
                                                    ToolTip.Tip="Browse for an executable"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                                        </Grid>

                                        <TextBlock Text="ARGUMENTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSubtle}"/>
                                        <TextBox Text="{Binding Tools.SelectedTool.Arguments, Mode=TwoWay}"
                                                 LostFocus="ToolField_Changed"
                                                 FontFamily="Consolas" FontSize="11"
                                                 Watermark="steam://rungameid/…   to reach a non-Steam shortcut's Proton prefix"/>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Tools.SelectedTool.MountBeforeLaunch, Mode=TwoWay}"
                                                      Click="ToolField_Changed"
                                                      Content="Mount mods before launching" FontSize="11"/>
                                            <Button Grid.Column="1"
                                                    Command="{Binding Tools.RemoveToolCommand}"
                                                    CommandParameter="{Binding Tools.SelectedTool}"
                                                    Content="✕  REMOVE"
                                                    ToolTip.Tip="Remove this tool"
                                                    FontSize="10" Padding="8,4"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource StatusDanger}" BorderThickness="1"
                                                    Foreground="{DynamicResource StatusDanger}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Tools.StatusMessage}" FontSize="10"
                                                   Foreground="{DynamicResource StatusDanger}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Tools.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,4"/>
                                    </StackPanel>

                                    <Button Click="AddTool_Click"
                                            HorizontalAlignment="Stretch" Padding="8"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="+" Foreground="{DynamicResource AccentColor}"/>
                                            <TextBlock Text="ADD TOOL" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Plugin tabs are added dynamically in MainWindow.axaml.cs -->

                </TabControl>
            </Border>
        </Grid>

        <!-- 3. Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarHeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{Binding Vfs.MountButtonColor}" FontSize="8" VerticalAlignment="Center" IsVisible="{Binding !Installer.IsInstalling}"/>
                    <ProgressBar Value="{Binding Installer.TotalInstallProgress}" Maximum="100" Width="40" Height="4" IsVisible="{Binding Installer.IsInstalling}" 
                                 IsIndeterminate="{Binding Installer.IsTotalProgressIndeterminate}"
                                 VerticalAlignment="Center" Background="{DynamicResource BorderColor}" Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModList.AllMods.Count, StringFormat='{}{0} Mods'}" FontSize="10" Foreground="{DynamicResource TextSubtle}"/>
                    <TextBlock Text="·" Foreground="{DynamicResource TextSubtle}"/>
                    <TextBlock Text="{Binding Vfs.SafeSwapStatusText}" Foreground="{Binding Vfs.SafeSwapStatusColor}" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
