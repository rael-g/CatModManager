<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!--
      TEMPORARY. Lilmihe.Lib 1.1.0 is not on nuget.org yet — it is the unreleased version in the
      sibling Lilmihe repository, built with `dotnet pack -o artifacts/localfeed`. Remove this source
      once 1.1.0 is published; the PackageReference does not change when it goes.

      A checkout without that repository beside this one cannot restore. That is the cost of using an
      unpublished dependency, and it is why this comment names the deadline rather than hiding it.
    -->
    <add key="lilmihe-local" value="../Lilmihe/artifacts/localfeed" />
  </packageSources>
</configuration>
